{
    "name": "bitbag/przelewy24-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "type": "sylius-plugin",
    "description": "Przelewy24 payment plugin for Sylius applications.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.0",
        "php-http/message-factory": "^1.1",
        "league/flysystem-bundle": "^3.4",
        "winzou/state-machine": "^0.4.4",
        "winzou/state-machine-bundle": "^0.6.2",
        "sonata-project/block-bundle": "^5.2",
        "jms/serializer": "^3.32.5",
        "jms/serializer-bundle": "^5.5",
        "friendsofsymfony/rest-bundle": "^3.8",
        "api-platform/doctrine-orm": "^v4.1.7",
        "api-platform/symfony": "^v4.1.7",
        "sylius/twig-hooks": "^0.9.1",
        "symfony/ux-icons": "^2.25",
        "symfony/ux-twig-component": "^2.25",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "symfony/webpack-encore-bundle": "^2.1",
        "behat/behat": "^3.6.1",
        "behat/mink-selenium2-driver": "1.7",
        "dmore/behat-chrome-extension": "^1.3",
        "dmore/chrome-mink-driver": "^2.7",
        "friends-of-behat/mink": "^1.8",
        "friends-of-behat/mink-browserkit-driver": "^1.4",
        "friends-of-behat/mink-debug-extension": "^2.0.0",
        "friends-of-behat/mink-extension": "^2.4",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.0",
        "friends-of-behat/symfony-extension": "^2.1",
        "friends-of-behat/variadic-extension": "^1.3",
        "phpspec/phpspec": "^8.0",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "0.12.88",
        "phpstan/phpstan-doctrine": "0.12.37",
        "phpstan/phpstan-strict-rules": "^0.12.0",
        "phpstan/phpstan-symfony": "^0.12",
        "phpstan/phpstan-webmozart-assert": "0.12.12",
        "phpunit/phpunit": "^9.5",
        "symfony/browser-kit": "^5.4 || ^6.0",
        "symfony/debug-bundle": "^5.4 || ^6.0",
        "symfony/dotenv": "^5.4 || ^6.0",
        "symfony/intl": "^5.4 || ^6.0",
        "symfony/web-profiler-bundle": "^4.4 || ^5.2 || ^5.4 || ^6.0",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "bitbag/coding-standard": "^1.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BitBag\\SyliusPrzelewy24Plugin\\": "src/",
            "Tests\\BitBag\\SyliusPrzelewy24Plugin\\TestApplication\\": "tests/TestApplication/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\BitBag\\SyliusPrzelewy24Plugin\\": "spec/"
        }
    },
    "conflict": {
        "symfony/framework-bundle": "6.2.8"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/thanks": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": true,
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.1"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Sylius/TestApplication"
        }
    ]
}
